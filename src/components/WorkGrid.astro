---
import Photo from "./Photo.astro";
import landscape from "../images/work/dummy-landscape.jpg";
import landscapeWide from "../images/work/dummy-landscape-wide.jpg";
import portrait from "../images/work/dummy-portrait.jpg";
import portraitTall from "../images/work/dummy-portrait-tall.jpg";

// 12-column scaffold, but every item claims a different, non-matching span
// so the split point between items shifts row to row — no column line ever
// lines up twice in a row, which is what kills the "grid" feeling.
const items = [
	{ src: landscape, width: 700, orientation: "landscape", span: 7 },
	{ src: portrait, width: 460, orientation: "portrait", span: 4 },
	{ src: landscapeWide, width: 620, orientation: "landscape", span: 5 },
	{ src: portraitTall, width: 380, orientation: "portrait", span: 3 },
	{ src: landscape, width: 760, orientation: "landscape", span: 8 },
	{ src: portrait, width: 460, orientation: "portrait", span: 4 },
	{ src: landscapeWide, width: 700, orientation: "landscape", span: 6 },
	{ src: portraitTall, width: 380, orientation: "portrait", span: 3 },
	{ src: landscape, width: 700, orientation: "landscape", span: 7 },
];
---

<div class="work-grid">
	{
		items.map((item, i) => (
			<div
				class:list={["item", item.orientation, i % 2 === 0 ? "align-start" : "align-end"]}
				style={`--span: ${item.span}; --drift: ${((i * 37) % 5) - 2}`}
			>
				<Photo src={item.src} alt="" width={item.width} />
			</div>
		))
	}
</div>

<style>
	.work-grid {
		display: flex;
		flex-direction: column;
	}

	.item {
		margin-bottom: 3rem;
	}

	.item :global(img) {
		display: block;
		height: auto;
	}

	.landscape :global(img) {
		width: 100%;
	}

	.portrait :global(img) {
		width: 72%;
	}

	.portrait.align-end :global(img) {
		margin-left: auto;
	}

	@media (min-width: 46rem) {
		.work-grid {
			display: grid;
			grid-template-columns: repeat(12, 1fr);
			grid-auto-flow: row dense;
			column-gap: 1.75rem;
			row-gap: 0;
			align-items: start;
		}

		.item {
			grid-column: span var(--span);
			margin-bottom: 3.5rem;
			transform: translateY(calc(var(--drift) * 1.1rem));
		}

		.landscape :global(img),
		.portrait :global(img) {
			width: 100%;
			margin-left: 0;
		}
	}
</style>
