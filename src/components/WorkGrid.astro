---
import Photo from "./Photo.astro";
import landscape from "../images/work/dummy-landscape.jpg";
import landscapeWide from "../images/work/dummy-landscape-wide.jpg";
import portrait from "../images/work/dummy-portrait.jpg";
import portraitTall from "../images/work/dummy-portrait-tall.jpg";

const items = [
	{ src: landscape, width: 700 },
	{ src: portrait, width: 500 },
	{ src: landscapeWide, width: 700 },
	{ src: portraitTall, width: 500 },
	{ src: landscape, width: 700 },
	{ src: portrait, width: 500 },
	{ src: landscapeWide, width: 700 },
	{ src: portraitTall, width: 500 },
	{ src: landscape, width: 700 },
];
---

<div class="work-grid">
	{
		items.map((item) => (
			<div class="item">
				<Photo src={item.src} alt="" width={item.width} />
			</div>
		))
	}
</div>

<style>
	.work-grid {
		column-count: 3;
		column-gap: 3rem;
	}

	.item {
		break-inside: avoid;
		margin-bottom: 3.5rem;
	}

	.item:nth-child(3n + 2) {
		margin-bottom: 5.5rem;
	}

	.item:nth-child(3n) {
		margin-bottom: 2rem;
	}

	.item :global(img) {
		display: block;
		width: 100%;
		height: auto;
	}

	@media (max-width: 900px) {
		.work-grid {
			column-count: 2;
			column-gap: 2rem;
		}
	}

	@media (max-width: 560px) {
		.work-grid {
			column-count: 1;
		}

		.item,
		.item:nth-child(3n + 2),
		.item:nth-child(3n) {
			margin-bottom: 2.5rem;
		}
	}
</style>
