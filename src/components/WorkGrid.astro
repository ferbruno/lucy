---
import Photo from "./Photo.astro";
import landscape from "../images/work/dummy-landscape.jpg";
import landscapeWide from "../images/work/dummy-landscape-wide.jpg";
import portrait from "../images/work/dummy-portrait.jpg";
import portraitTall from "../images/work/dummy-portrait-tall.jpg";

const items = [
	{ src: landscape, width: 700, orientation: "landscape" },
	{ src: portrait, width: 500, orientation: "portrait" },
	{ src: landscapeWide, width: 700, orientation: "landscape" },
	{ src: portraitTall, width: 500, orientation: "portrait" },
	{ src: landscape, width: 700, orientation: "landscape" },
	{ src: portrait, width: 500, orientation: "portrait" },
	{ src: landscapeWide, width: 700, orientation: "landscape" },
	{ src: portraitTall, width: 500, orientation: "portrait" },
	{ src: landscape, width: 700, orientation: "landscape" },
];
---

<div class="work-grid">
	{
		items.map((item, i) => (
			<div class:list={["item", item.orientation, i % 2 === 0 ? "align-start" : "align-end"]}>
				<Photo src={item.src} alt="" width={item.width} />
			</div>
		))
	}
</div>

<style>
	.work-grid {
		column-count: 2;
		column-gap: 3rem;
	}

	.item {
		break-inside: avoid;
		margin-bottom: 3.5rem;
	}

	.item:nth-child(3n + 2) {
		margin-bottom: 5.5rem;
	}

	.item:nth-child(3n) {
		margin-bottom: 2rem;
	}

	.item :global(img) {
		display: block;
		height: auto;
	}

	.landscape :global(img) {
		width: 100%;
	}

	.portrait :global(img) {
		width: 68%;
	}

	.portrait.align-start :global(img) {
		margin-right: auto;
	}

	.portrait.align-end :global(img) {
		margin-left: auto;
	}

	@media (max-width: 560px) {
		.work-grid {
			column-count: 1;
		}

		.item,
		.item:nth-child(3n + 2),
		.item:nth-child(3n) {
			margin-bottom: 2.5rem;
		}

		.portrait :global(img) {
			width: 55%;
		}
	}
</style>
