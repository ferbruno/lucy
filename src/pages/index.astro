---
import BaseLayout from "../layouts/BaseLayout.astro";
import Photo from "../components/Photo.astro";
import { NAME, BIRTH, BIO, SITE_DESCRIPTION } from "../consts";
import lucilaPortrait from "../images/lucila.jpg";

const pageURL = new URL(Astro.url.pathname, Astro.site).toString();
const imageURL = new URL("/og-default.jpg", Astro.site).toString();
const personId = `${pageURL}#lucila-heinberg`;

const structuredData = {
	"@context": "https://schema.org",
	"@graph": [
		{
			"@type": "ProfilePage",
			"@id": `${pageURL}#profile`,
			url: pageURL,
			name: NAME,
			mainEntity: { "@id": personId },
		},
		{
			"@type": "Person",
			"@id": personId,
			name: NAME,
			description: SITE_DESCRIPTION,
			image: imageURL,
			url: pageURL,
			jobTitle: "Fotógrafa",
			birthDate: "1979",
			birthPlace: {
				"@type": "Place",
				name: "Buenos Aires, Argentina",
			},
			nationality: {
				"@type": "Country",
				name: "Argentina",
			},
			alumniOf: {
				"@type": "EducationalOrganization",
				name: "SICA",
			},
			award: [
				"Premio Felifa (La Luminosa), 2012",
				"Mención del Salón Nacional de las Artes Visuales, 2012",
			],
			knowsAbout: ["Fotografía analógica", "Revelado color manual"],
			sameAs: [
				"https://www.instagram.com/lucila_victoria_/",
				"https://www.facebook.com/LucilaHeinbergPhoto/",
			],
		},
		{
			"@type": "Book",
			name: "Ahora",
			datePublished: "2012",
			author: { "@id": personId },
		},
		{
			"@type": "Book",
			name: "Bardo",
			datePublished: "2021-08",
			author: { "@id": personId },
			offers: [
				{
					"@type": "Offer",
					url: "https://tienda.malba.org.ar/products/libro-bardo-lucila-heinberg",
					seller: { "@type": "Organization", name: "Tienda MALBA" },
				},
				{
					"@type": "Offer",
					url: "https://www.printedmatter.org/catalog/59142/",
					seller: { "@type": "Organization", name: "Printed Matter" },
				},
			],
		},
	],
};
---

<BaseLayout>
	<script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
	<main>
		<div class="hero">
			<Photo src={lucilaPortrait} alt="Lucila Heinberg" width={1000} />
		</div>
		<div class="bio">
			<div class="intro">
				<h1>{NAME}</h1>
				<p class="birth">{BIRTH}</p>
			</div>
			<p set:html={BIO} />
		</div>
	</main>
	<footer>
		<a href="https://www.instagram.com/lucila_victoria_/" target="_blank" rel="noopener noreferrer">
			Instagram
		</a>
	</footer>
</BaseLayout>

<style>
	main {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 2.5rem;
		padding: 4rem 1.5rem 6rem;
	}

	.hero {
		width: 100%;
		max-width: 42rem;
	}

	.hero :global(img) {
		display: block;
		width: 100%;
		height: auto;
	}

	.bio {
		max-width: 42rem;
	}

	.intro {
		margin-bottom: 1.5rem;
	}

	h1,
	p {
		margin: 0;
		font-family: Georgia, "Times New Roman", serif;
		font-size: 1.2rem;
		line-height: 1.4;
		color: #111;
	}

	h1 {
		font-weight: 700;
	}

	.birth {
		font-weight: 400;
	}

	.bio :global(a) {
		color: inherit;
		text-decoration-thickness: 1px;
		text-underline-offset: 2px;
	}

	footer {
		display: flex;
		justify-content: center;
		padding: 0 1.5rem 4rem;
	}

	footer a {
		font-family: Georgia, "Times New Roman", serif;
		font-size: 0.95rem;
		color: #111;
		text-decoration-thickness: 1px;
		text-underline-offset: 2px;
	}
</style>
