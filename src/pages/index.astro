---
import BaseLayout from "../layouts/BaseLayout.astro";
import Photo from "../components/Photo.astro";
import { NAME, BIRTH, BIO, BOOKS, SITE_DESCRIPTION } from "../consts";
import lucilaPortrait from "../images/lucila.jpg";

const pageURL = new URL(Astro.url.pathname, Astro.site).toString();
const imageURL = new URL("/og-default.jpg", Astro.site).toString();
const personId = `${pageURL}#lucila-heinberg`;

const structuredData = {
	"@context": "https://schema.org",
	"@graph": [
		{
			"@type": "ProfilePage",
			"@id": `${pageURL}#profile`,
			url: pageURL,
			name: NAME,
			mainEntity: { "@id": personId },
		},
		{
			"@type": "Person",
			"@id": personId,
			name: NAME,
			description: SITE_DESCRIPTION,
			image: imageURL,
			url: pageURL,
			jobTitle: "Fotógrafa",
			birthDate: "1979",
			birthPlace: {
				"@type": "Place",
				name: "Buenos Aires, Argentina",
			},
			nationality: {
				"@type": "Country",
				name: "Argentina",
			},
			alumniOf: {
				"@type": "EducationalOrganization",
				name: "SICA",
			},
			award: [
				"Premio Felifa (La Luminosa), 2012",
				"Mención del Salón Nacional de las Artes Visuales, 2012",
			],
			knowsAbout: ["Fotografía analógica", "Revelado color manual"],
			sameAs: [
				"https://www.instagram.com/lucila_victoria_/",
				"https://www.facebook.com/LucilaHeinbergPhoto/",
			],
		},
		...BOOKS.map((book) => ({
			"@type": "Book",
			name: book.title,
			datePublished: book.datePublished,
			author: { "@id": personId },
			offers: book.retailers.map((retailer) => ({
				"@type": "Offer",
				url: retailer.url,
				seller: { "@type": "Organization", name: retailer.name },
			})),
		})),
	],
};
---

<BaseLayout>
	<script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
	<main>
		<div class="hero">
			<Photo src={lucilaPortrait} alt="Lucila Heinberg" width={1000} />
		</div>
		<div class="bio">
			<div class="intro">
				<h1>{NAME}</h1>
				<p class="birth">{BIRTH}</p>
			</div>
			<p set:html={BIO} />
		</div>
		<section class="books">
			<h2>Comprar libros</h2>
			<ul>
				{
					BOOKS.map((book) => (
						<li>
							<em>{book.title}</em> —{" "}
							{book.retailers.map((retailer, i) => (
								<>
									{i > 0 && " · "}
									<a href={retailer.url} target="_blank" rel="noopener noreferrer">
										{retailer.name}
									</a>
								</>
							))}
						</li>
					))
				}
			</ul>
		</section>
	</main>
	<footer>
		<div class="footer-inner">
			<a href="https://www.instagram.com/lucila_victoria_/" target="_blank" rel="noopener noreferrer">
				Instagram
			</a>
		</div>
	</footer>
</BaseLayout>

<style>
	main {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 2.5rem;
		padding: 4rem 1.5rem 6rem;
	}

	.hero {
		width: 100%;
		max-width: 42rem;
	}

	.hero :global(img) {
		display: block;
		width: 100%;
		height: auto;
	}

	.bio {
		max-width: 42rem;
	}

	.intro {
		margin-bottom: 1.5rem;
	}

	h1,
	p {
		margin: 0;
		font-family: Georgia, "Times New Roman", serif;
		font-size: 1.2rem;
		line-height: 1.4;
		color: #111;
	}

	h1 {
		font-weight: 700;
	}

	.birth {
		font-weight: 400;
	}

	.bio :global(a),
	.books a {
		color: inherit;
		text-decoration-thickness: 1px;
		text-underline-offset: 2px;
	}

	.books {
		max-width: 42rem;
	}

	.books h2 {
		font-weight: 700;
		margin-bottom: 1rem;
	}

	.books ul {
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.books li {
		font-family: Georgia, "Times New Roman", serif;
		font-size: 1.2rem;
		line-height: 1.4;
		color: #111;
	}

	.books li + li {
		margin-top: 0.5rem;
	}

	footer {
		display: flex;
		justify-content: center;
		padding: 0 1.5rem 4rem;
	}

	footer .footer-inner {
		width: 100%;
		max-width: 42rem;
		text-align: left;
	}

	footer a {
		font-family: Georgia, "Times New Roman", serif;
		font-size: 0.95rem;
		color: #111;
		text-decoration-thickness: 1px;
		text-underline-offset: 2px;
	}
</style>
