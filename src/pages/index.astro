---
import BaseLayout from "../layouts/BaseLayout.astro";
import { NAME, BIRTH, BIO } from "../consts";
---

<BaseLayout>
	<main>
		<div class="bio">
			<hr />
			<div class="intro">
				<h1>{NAME}</h1>
				<p class="birth">{BIRTH}</p>
			</div>
			<p>{BIO}</p>
			<hr />
		</div>
	</main>
</BaseLayout>

<style>
	main {
		display: flex;
		justify-content: center;
		padding: 6rem 1.5rem;
	}

	.bio {
		max-width: 42rem;
	}

	hr {
		width: 4rem;
		border: none;
		border-top: 3px solid #111;
		margin: 0 0 2.5rem;
	}

	.bio hr:last-child {
		margin: 2.5rem 0 0;
	}

	.intro {
		margin-bottom: 1.5rem;
	}

	h1,
	p {
		margin: 0;
		font-family: Georgia, "Times New Roman", serif;
		font-weight: 700;
		font-size: 1.5rem;
		line-height: 1.5;
		color: #111;
	}

	.birth {
		margin-top: 0.25rem;
	}
</style>
